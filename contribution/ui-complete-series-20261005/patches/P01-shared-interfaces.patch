diff --git a/apps/rosen-service2/tests/scanners/cardano.spec.ts b/apps/rosen-service2/tests/scanners/cardano.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d069277a9564deaec814e0c2a6749f81d0ac99f2
--- /dev/null
+++ b/apps/rosen-service2/tests/scanners/cardano.spec.ts
@@ -0,0 +1,123 @@
+import '@rosen-bridge/extended-typeorm/bootstrap';
+
+import { beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { DefaultLogger, DummyLogger } from '@rosen-bridge/abstract-logger';
+import {
+  BLOCK_CLEANUP_THRESHOLD_DURATION,
+  BLOCK_TRIM_COUNT_IN_ROUND,
+} from '@rosen-bridge/abstract-scanner/dist/constants.js';
+import { CardanoOgmiosObservationExtractor } from '@rosen-bridge/cardano-observation-extractor';
+import { CardanoOgmiosScanner } from '@rosen-bridge/cardano-scanner';
+import { TokenMap } from '@rosen-bridge/extended-tokens';
+import { DataSource } from '@rosen-bridge/extended-typeorm';
+
+const configs = vi.hoisted(() => ({
+  chains: {
+    cardano: {
+      method: 'ogmios',
+      ogmios: {
+        connection: {
+          address: '127.0.0.1',
+          port: 1337,
+          initialSlot: 321,
+          initialHash: '11'.repeat(32),
+        },
+      },
+    },
+  },
+  contracts: { cardano: { addresses: { lock: 'synthetic-cardano-lock' } } },
+}));
+
+vi.mock('../../src/configs', () => ({ configs }));
+
+describe('getCardanoScanner', () => {
+  let getCardanoScanner: typeof import('../../src/scanners/cardano').getCardanoScanner;
+  let dataSource: DataSource;
+  let tokenMap: TokenMap;
+
+  beforeAll(async () => {
+    DefaultLogger.init(new DummyLogger());
+    ({ getCardanoScanner } = await import('../../src/scanners/cardano'));
+  });
+
+  beforeEach(() => {
+    configs.chains.cardano.method = 'ogmios';
+    Object.assign(configs.chains.cardano.ogmios.connection, {
+      address: '127.0.0.1',
+      port: 1337,
+      initialSlot: 321,
+      initialHash: '11'.repeat(32),
+    });
+    dataSource = new DataSource({ type: 'sqlite', database: ':memory:' });
+    tokenMap = new TokenMap();
+  });
+
+  /**
+   * @target getCardanoScanner should supply the scanner cleanup defaults
+   * @dependencies Controlled config; genuine scanner, token map and unconnected SQLite DataSource.
+   * @scenario Select Ogmios with a loopback endpoint and construct the scanner without starting it.
+   * @expected Both cleanup fields equal the current abstract-scanner constants.
+   */
+  it('should supply the scanner cleanup defaults', async () => {
+    const scanner = await getCardanoScanner(dataSource, tokenMap);
+
+    expect(scanner).toBeInstanceOf(CardanoOgmiosScanner);
+    expect(scanner.blockCleanupConfig).toEqual({
+      blockCleanupThresholdDuration: BLOCK_CLEANUP_THRESHOLD_DURATION,
+      blockTrimCountInRound: BLOCK_TRIM_COUNT_IN_ROUND,
+    });
+  });
+
+  /**
+   * @target getCardanoScanner should register the actual Ogmios observation extractor
+   * @dependencies Controlled config; genuine scanner and observation extractor; no scanner start.
+   * @scenario Construct the Ogmios scanner with an empty real token map and local DataSource.
+   * @expected Its registration queue contains one CardanoOgmiosObservationExtractor with the real ID.
+   */
+  it('should register the actual Ogmios observation extractor', async () => {
+    const scanner = await getCardanoScanner(dataSource, tokenMap);
+
+    expect(scanner.newExtractors.length).toEqual(1);
+    expect(scanner.newExtractors[0]).toBeInstanceOf(CardanoOgmiosObservationExtractor);
+    expect(scanner.newExtractors[0].getId()).toEqual('cardano-ogmios-extractor');
+  });
+
+  /**
+   * @target getCardanoScanner should preserve the configured Ogmios intersection
+   * @dependencies Controlled config; genuine Ogmios constructor; no WebSocket connection.
+   * @scenario Change the loopback host, port, initial slot and initial hash before construction.
+   * @expected The scanner retains those four inputs alongside the current cleanup policy.
+   */
+  it('should preserve the configured Ogmios intersection', async () => {
+    Object.assign(configs.chains.cardano.ogmios.connection, {
+      address: 'localhost',
+      port: 1447,
+      initialSlot: 654,
+      initialHash: '22'.repeat(32),
+    });
+
+    const scanner = await getCardanoScanner(dataSource, tokenMap);
+
+    expect(scanner).toMatchObject({
+      host: 'localhost',
+      port: 1447,
+      initPoint: { id: '22'.repeat(32), slot: 654 },
+    });
+    expect(dataSource.isInitialized).toEqual(false);
+  });
+
+  /**
+   * @target getCardanoScanner should reject an unsupported scanner method
+   * @dependencies Controlled config; genuine factory and unconnected local DataSource.
+   * @scenario Replace the Ogmios method with an unsupported literal while retaining its endpoint.
+   * @expected The factory rejects the method before returning or starting a scanner.
+   */
+  it('should reject an unsupported scanner method', async () => {
+    configs.chains.cardano.method = 'unsupported';
+
+    await expect(getCardanoScanner(dataSource, tokenMap)).rejects.toThrow(
+      'Unsupported or missing Cardano scanner method',
+    );
+  });
+});
diff --git a/apps/rosen-service2/tests/utils.spec.ts b/apps/rosen-service2/tests/utils.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d729c72c978978aa928b7fca9ad01fb3dc7c7ae7
--- /dev/null
+++ b/apps/rosen-service2/tests/utils.spec.ts
@@ -0,0 +1,135 @@
+import '@rosen-bridge/extended-typeorm/bootstrap';
+
+import { beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { DefaultLogger, DummyLogger } from '@rosen-bridge/abstract-logger';
+import { TokenMap } from '@rosen-bridge/extended-tokens';
+import { DataSource } from '@rosen-bridge/extended-typeorm';
+import { ErgoNetworkType } from '@rosen-bridge/scanner-interfaces';
+import { CommitmentExtractor } from '@rosen-bridge/watcher-data-extractor';
+
+import type { ChainConfigs } from '../src/types';
+
+const configs = vi.hoisted(() => ({
+  chains: {
+    ergo: {
+      method: 'explorer',
+      explorer: { connections: [{ url: 'http://127.0.0.1:18081' }] },
+      node: { connections: [{ url: 'http://127.0.0.1:18082' }] },
+    },
+  },
+}));
+
+vi.mock('../src/configs', () => ({ configs }));
+
+describe('createCommitmentExtractor', () => {
+  let createCommitmentExtractor: typeof import('../src/utils').createCommitmentExtractor;
+  let dataSource: DataSource;
+  let tokenMap: TokenMap;
+  let chainConfigs: ChainConfigs;
+  const logger = new DummyLogger();
+  const address = '9iMjQx8PzwBKXRvsFUJFJAPoy31znfEeBUGz8DRkcnJX4rJYjVd';
+
+  beforeAll(async () => {
+    DefaultLogger.init(logger);
+    ({ createCommitmentExtractor } = await import('../src/utils'));
+  });
+
+  beforeEach(() => {
+    configs.chains.ergo.method = 'explorer';
+    configs.chains.ergo.explorer.connections[0].url = 'http://127.0.0.1:18081';
+    dataSource = new DataSource({ type: 'sqlite', database: ':memory:' });
+    tokenMap = new TokenMap();
+    chainConfigs = {
+      addresses: {
+        lock: address,
+        cold: address,
+        Commitment: address,
+        WatcherTriggerEvent: address,
+        WatcherPermit: address,
+        Fraud: address,
+      },
+      tokens: { RWTId: '33'.repeat(32) },
+      cleanupConfirm: 10,
+    };
+  });
+
+  /**
+   * @target createCommitmentExtractor should construct an inactive explorer initializer
+   * @dependencies Controlled config; genuine CommitmentExtractor, WASM address decode and DataSource.
+   * @scenario Construct for cardano with a valid synthetic Ergo address and loopback explorer URL.
+   * @expected The real extractor retains its ID, address, explorer URL and inactive initialization.
+   */
+  it('should construct an inactive explorer initializer', () => {
+    const extractor = createCommitmentExtractor(
+      'cardano',
+      dataSource,
+      chainConfigs,
+      tokenMap,
+      logger,
+    );
+
+    expect(extractor).toBeInstanceOf(CommitmentExtractor);
+    expect(extractor.getId()).toEqual('cardano-commitment-extractor');
+    expect(extractor).toMatchObject({
+      initializeOptions: {
+        active: false,
+        type: ErgoNetworkType.Explorer,
+        url: 'http://127.0.0.1:18081',
+        address,
+      },
+    });
+    expect(dataSource.isInitialized).toEqual(false);
+  });
+
+  /**
+   * @target createCommitmentExtractor should select the configured node initializer
+   * @dependencies Controlled config; genuine extractor constructor; no initializer or network start.
+   * @scenario Change only the Ergo method to node while retaining distinct loopback endpoints.
+   * @expected The initialization options use the Node enum and node URL, and remain inactive.
+   */
+  it('should select the configured node initializer', () => {
+    configs.chains.ergo.method = 'node';
+
+    const extractor = createCommitmentExtractor('ergo', dataSource, chainConfigs, tokenMap, logger);
+
+    expect(extractor).toMatchObject({
+      initializeOptions: {
+        active: false,
+        type: ErgoNetworkType.Node,
+        url: 'http://127.0.0.1:18082',
+        address,
+      },
+    });
+    expect(extractor.getId()).toEqual('ergo-commitment-extractor');
+  });
+
+  /**
+   * @target createCommitmentExtractor should reject a missing Ergo endpoint
+   * @dependencies Controlled config; genuine network resolver and factory; no remote transport.
+   * @scenario Remove only the explorer URL from the default explorer configuration.
+   * @expected The factory throws the resolver's missing-URL error before constructing an extractor.
+   */
+  it('should reject a missing Ergo endpoint', () => {
+    configs.chains.ergo.explorer.connections[0].url = '';
+
+    expect(() =>
+      createCommitmentExtractor('cardano', dataSource, chainConfigs, tokenMap, logger),
+    ).toThrow('Ergo network URL is not configured.');
+  });
+
+  /**
+   * @target createCommitmentExtractor should reject a malformed commitment address
+   * @dependencies Controlled config; genuine CommitmentExtractor and Ergo WASM address parser.
+   * @scenario Change only the valid commitment address to an invalid Base58 string.
+   * @expected The real constructor rejects the address without initializing the local DataSource.
+   */
+  it('should reject a malformed commitment address', () => {
+    chainConfigs.addresses.Commitment = 'invalid-commitment-address';
+
+    expect(() =>
+      createCommitmentExtractor('cardano', dataSource, chainConfigs, tokenMap, logger),
+    ).toThrow();
+    expect(dataSource.isInitialized).toEqual(false);
+  });
+});
