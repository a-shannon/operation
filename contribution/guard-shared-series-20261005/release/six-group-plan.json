          "name": "guard-service",
          "type": "minor"
        }
      ],
      "summary": "Add `firo.electrumx.useTls` config to toggle between SSL and plain TCP ElectrumX connections (defaults to `true`, preserving current behavior)",
      "id": "slow-avocados-behave"
    },
    {
      "releases": [
