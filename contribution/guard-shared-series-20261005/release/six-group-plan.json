{
  "changesets": [
    {
      "releases": [
        {
          "name": "@rosen-chains/abstract-chain",
          "type": "patch"
        }
      ],
      "summary": "Reorder `verifyEvent` to run `verifyLockTransactionExtraConditions` before extracting rosen data from the lock transaction",
      "id": "abstract-chain-verify-event-order"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/bitcoin",
          "type": "minor"
        },
        {
          "name": "@rosen-chains/bitcoin-runes",
          "type": "minor"
        }
      ],
      "summary": "Add `txMaxFee` config to cap the absolute tx fee allowed during verification, and reject transactions whose fee exceeds it regardless of slippage",
      "id": "bitcoin-tx-max-fee-cap"
    },
    {
      "releases": [
        {
          "name": "guard-service",
          "type": "patch"
        }
      ],
      "summary": "Increase the default `txFeeSlippage` tolerance for Bitcoin and Bitcoin Runes transactions",
      "id": "brave-nails-greet"
    },
    {
      "releases": [
        {
          "name": "guard-service",
          "type": "patch"
        }
      ],
      "summary": "Store cached asset balances as exact decimal text and migrate existing integer\nvalues without passing them through JavaScript floating-point numbers.",
      "id": "cached-balance-precision"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/cardano-blockfrost-network",
          "type": "patch"
        }
      ],
      "summary": "Stop throwing `FailedError` on failed on-chain transactions in `getTransaction` and return the transaction with `isValid: false` instead\nFix `getUtxo` and `isBoxUnspentAndValid` to look up the requested output by its actual `output_index` instead of its position in the `txsUtxos` response array",
      "id": "cardano-blockfrost-tx-failed-on-chain"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/cardano-koios-network",
          "type": "patch"
        }
      ],
      "summary": "Stop throwing `FailedError` on failed on-chain transactions in `getTransaction` and return the transaction with `isValid: false` instead\nFix `getUtxo` and `isBoxUnspentAndValid` to account for the effective on-chain outcome of a failed transaction",
      "id": "cardano-koios-tx-failed-on-chain"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/cardano",
          "type": "patch"
        }
      ],
      "summary": "Fix `verifyLockTransactionExtraConditions` to correctly detect and reject lock transactions that failed on-chain instead of always returning true. `CardanoTx` gains an `isValid` field reflecting whether the transaction succeeded on-chain.",
      "id": "cardano-lock-tx-failed-on-chain"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/ergo",
          "type": "minor"
        },
        {
          "name": "@rosen-chains/ergo-explorer-network",
          "type": "patch"
        },
        {
          "name": "@rosen-chains/ergo-node-network",
          "type": "patch"
        }
      ],
      "summary": "Add explicit Ergo transaction submission authorization at the final transport\nadapter boundary, preserving legacy submissions and refusing unsupported networks.",
      "id": "ergo-authorized-submission"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/ergo",
          "type": "minor"
        }
      ],
      "summary": "Check signed Ergo transaction accounting and payment consistency against exact\nserialized input identities, and release fetched WASM transaction ownership.",
      "id": "ergo-signed-accounting"
    },
    {
      "releases": [
        {
          "name": "guard-service",
          "type": "patch"
        }
      ],
      "summary": "Add exact reduced-to-signed Ergo body and auxiliary-box consistency checks for\nauthorization consumers.",
      "id": "ergo-signed-semantics"
    },
    {
      "releases": [
        {
          "name": "@rosen-chains/evm",
          "type": "patch"
        }
      ],
      "summary": "Remove `maxPriorityFeePerGas` verification from `EvmChain.verifyTransactionFee`",
      "id": "evm-remove-max-priority-fee-verification"
    },
    {
      "releases": [
