    },
    {
      "releases": [
        {
          "name": "guard-service",
          "type": "minor"
        }
      ],
      "summary": "Add `extractors.initializeCommitments` config to enable initial sync for the commitment extractor, alongside the existing `extractors.initializeEventTriggers` (both disabled by default)",
      "id": "gentle-items-sing"
