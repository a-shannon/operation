        }
      ],
      "summary": "Add `scanners.blockCleanup.isActiveForErgoChain` and `scanners.blockCleanup.isActiveForNonErgoChains` config to enable periodic pruning of old scanned blocks",
      "id": "spicy-toys-clean"
    },
