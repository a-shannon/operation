+      it('does not let an old delayed outbound envelope acquire a renewed permit', async () => {
+        const signer = make('ecdsa', { signingTimeoutMs: 35 });
+        let release!: () => void;
+        const barrier = new Promise<void>((resolve) => {
+          release = resolve;
+        });
+        const first = queue(signer);
+        await tick();
