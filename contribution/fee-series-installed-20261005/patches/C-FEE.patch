+        chain === 'avalanche'
+          ? policy.guarantee
+          : feeGuaranteeDuration.get(chain);
+      if (
+        typeof value !== 'number' ||
+        !Number.isSafeInteger(value) ||
+        value <= 0 ||
+        value > 2147483647
+      )
+        throw new Error('Invalid Avalanche pruning guarantee');
+      return [chain, value];
+    }),
+  );
