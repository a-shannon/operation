+  bridgeFee: 100n,
+  networkFee: 1n,
+  rsnRatio: 1n,
+  rsnRatioDivisor: 1n,
+  feeRatio: 1n,
+});
+/** Builds fresh activation frontiers for the legacy chains. */
+export const heights = () =>
+  new Map(
+    [
+      'ergo',
+      'cardano',
+      'bitcoin',
+      'ethereum',
+      'binance',
+      'doge',
+      'bitcoin-runes',
+      'firo',
+      'handshake',
