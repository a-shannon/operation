+          name: 'AVAX',
+          fee: {},
+        },
+      ],
+      rawMap,
+      currentRawMap: structuredClone(rawMap),
+    };
+    const old = new deps.fees.MinimumFeeBoxBuilder(nft, address)
+      .setHeight(1)
+      .setToken(native)
+      .setValue(1000000n)
+      .addConfig(
+        new deps.fees.MinimumFeeConfig()
+          .setChainConfig('ergo', 1, common())
+          .setChainConfig('avalanche', 1, common()),
