+    };
+    const rawMap = [
+      {
+        avalanche: {
+          tokenId: 'avax',
+          type: 'native',
+          residency: 'native',
+          decimals: 18,
+        },
+        ergo: {
+          tokenId: native,
+          decimals: 9,
