diff --git a/tests/utils/mocked/avalancheScanner.mock.ts b/tests/utils/mocked/avalancheScanner.mock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a234aff5dd3bbfaf905030492795b91cfdb8f73b
