diff --git a/src/main/scala/rosen/bridge/AvalancheOverlayMerge.scala b/src/main/scala/rosen/bridge/AvalancheOverlayMerge.scala
new file mode 100644
index 0000000..c7b5b4f
--- /dev/null
+++ b/src/main/scala/rosen/bridge/AvalancheOverlayMerge.scala
@@ -0,0 +1,120 @@
+package rosen.bridge
+
+import io.circe.Json
+import info.BuildInfo
+
+import java.nio.charset.StandardCharsets
+import java.nio.file.{Files, Paths}
+import java.security.MessageDigest
+
+/** Add freshly compiled Avalanche configuration without replacing existing Rosen chains or assets. */
+object AvalancheOverlayMerge {
+  /** Require an object while retaining its unrelated fields. */
+  private def fields(value: Json, label: String) =
+    value.asObject.getOrElse(throw new IllegalArgumentException(s"$label must be an object"))
+
+  /** Require an explicit configuration version without assigning a release number. */
+  private def version(value: Json, label: String): Unit =
+    require(value.hcursor.downField("version").as[String].toOption.exists(_.trim.nonEmpty), s"$label requires a version")
+
+  /** Normalize EVM addresses and Ergo token bytes for cross-deployment collision checks. */
+  private def identity(value: String): String =
+    if (value.matches("0x[0-9a-fA-F]{40}") || value.matches("[0-9a-fA-F]{64}")) value.toLowerCase else value
+
+  /** Read the flat token identities emitted by the existing contract generator. */
+  private def contractTokenIds(value: Json, label: String): Vector[String] =
+    fields(value, label).toVector.map { case (key, token) =>
+      token.asString.filter(_.trim.nonEmpty).map(identity)
+        .getOrElse(throw new IllegalArgumentException(s"$label.$key requires an identity"))
+    }
+
+  /** Merge only a newly prepared chain; existing configuration and release versions stay intact. */
+  def merge(contractsBase: Json, tokensBase: Json, contractsOverlay: Json, tokensOverlay: Json): (Json, Json) = {
+    val contracts = fields(contractsBase, "contracts base")
+    val tokens = fields(tokensBase, "tokens base")
+    version(contractsBase, "contracts base")
+    version(tokensBase, "tokens base")
+    require(!contracts.contains("avalanche"), "Contracts base already contains Avalanche")
+    require(contracts("ergo").exists(_.isObject), "Contracts base requires its existing Ergo configuration")
+    require(contracts("tokens") == contractsOverlay.hcursor.downField("tokens").focus, "Assigned global tokens differ from the existing Rosen deployment")
+    require(tokens.keys.toSet == Set("version", "tokens"), "Tokens base requires version and tokens")
+    val existing = tokens("tokens").flatMap(_.asArray).getOrElse(throw new IllegalArgumentException("Tokens base requires an array"))
+    val added = tokensOverlay.hcursor.downField("tokens").as[Vector[Json]].toOption.getOrElse(throw new IllegalArgumentException("Prepared tokens require an array"))
+    require(added.size == 2, "Preparation requires AVAX and JOE counterparts")
+    val existingContractIds = contractTokenIds(contracts("tokens").get, "existing global tokens") ++
+      contracts.toVector.filterNot { case (key, _) => key == "version" || key == "tokens" }.flatMap { case (key, profile) =>
+        profile.asObject.flatMap(_("tokens")).toVector.flatMap(value => contractTokenIds(value, s"existing $key tokens"))
+      }
+    val existingIds = existing.flatMap { set =>
+      val members = fields(set, "existing token set")
+      require(!members.contains("avalanche"), "Tokens base already contains Avalanche")
+      members.values.map { member =>
+        member.hcursor.downField("tokenId").as[String].toOption.filter(_.nonEmpty)
+          .map(identity).getOrElse(throw new IllegalArgumentException("Existing token member requires an identity"))
+      }
+    }
+    val addedIds = added.flatMap(set => fields(set, "prepared token set").values.map { member =>
+      identity(member.hcursor.downField("tokenId").as[String].toOption.getOrElse(throw new IllegalArgumentException("Prepared token requires an identity")))
+    })
+    val chain = contractsOverlay.hcursor.downField("avalanche").focus.getOrElse(throw new IllegalArgumentException("Prepared contracts require Avalanche"))
+    val chainTokens = fields(chain, "prepared Avalanche contracts")("tokens")
+      .getOrElse(throw new IllegalArgumentException("Prepared Avalanche contracts require tokens"))
+    // Global deployment tokens are intentionally reused; only chain and asset IDs are newly allocated.
+    val allocatedIds = contractTokenIds(chainTokens, "prepared Avalanche tokens") ++ addedIds
+    require(allocatedIds.distinct.size == allocatedIds.size, "Prepared chain and asset identities collide")
+    require(!allocatedIds.exists((existingContractIds ++ existingIds).contains), "Prepared identity collides with an existing Rosen contract or asset")
+    val mergedContracts = Json.fromJsonObject(contracts.add("avalanche", chain))
+    val mergedTokens = Json.fromJsonObject(tokens.add("tokens", Json.arr((existing ++ added): _*)))
+    (mergedContracts, mergedTokens)
+  }
+
+  /** Pin exact source/configuration bytes for the generated deployment candidate. */
+  private def digest(bytes: Array[Byte]): String =
+    MessageDigest.getInstance("SHA-256").digest(bytes).map(b => f"${b & 0xff}%02x").mkString
+
+  /** Collect compilation inputs without recording machine paths. */
+  private def sourcePins(): Vector[Json] = {
+    import scala.collection.JavaConverters._
+    val stream = Files.walk(Paths.get("src/main/scala"))
+    try {
+      val source = stream.iterator().asScala.filter(path => Files.isRegularFile(path) && (path.toString.endsWith(".scala") || path.toString.endsWith(".es"))).toVector
+      (source ++ Vector(Paths.get("build.sbt"), Paths.get("project/plugins.sbt"), Paths.get("project/build.properties")))
+        .sortBy(_.toString).map(path => Json.obj("path" -> Json.fromString(path.toString.replace('\\', '/')), "sha256" -> Json.fromString(digest(Files.readAllBytes(path)))))
+    } finally stream.close()
+  }
+
+  /** Regenerate from assigned values and write a fresh, disabled deployment candidate without network access. */
+  def main(args: Array[String]): Unit = {
+    require(args.length == 8 && args(0) == "--input" && args(2) == "--contracts-base" && args(4) == "--tokens-base" && args(6) == "--output",
+      "Usage: --input <assigned-values.json> --contracts-base <contracts.json> --tokens-base <tokens.json> --output <new-directory>")
+    val inputFiles = Vector("assigned-values" -> Paths.get(args(1)), "contracts-base" -> Paths.get(args(3)), "tokens-base" -> Paths.get(args(5)))
+    val bytes = inputFiles.map { case (_, path) => Files.readAllBytes(path) }
+    val inputs = bytes.map(value => AvalanchePreparation.parseInput(new String(value, StandardCharsets.UTF_8)))
+    val sources = sourcePins()
+    val prepared = AvalanchePreparation.prepare(inputs(0))
+    val merged = merge(inputs(1), inputs(2), prepared._1, prepared._2)
+    require(sourcePins() == sources, "Contract compilation sources changed during preparation")
+    inputFiles.zip(bytes).foreach { case ((_, path), captured) =>
+      require(java.util.Arrays.equals(captured, Files.readAllBytes(path)), "Deployment input changed during preparation")
+    }
+    val output = Paths.get(args(7))
+    require(!Files.exists(output) && Files.isDirectory(output.toAbsolutePath.getParent), "Output must be a new directory under an existing parent")
+    Files.createDirectory(output)
+    val payloads = Vector("contracts.json" -> merged._1, "tokens.json" -> merged._2)
+    val members = payloads.map { case (name, value) =>
+      val payload = (value.spaces2 + "\n").getBytes(StandardCharsets.UTF_8)
+      Files.write(output.resolve(name), payload)
+      Json.obj("path" -> Json.fromString(name), "bytes" -> Json.fromInt(payload.length), "sha256" -> Json.fromString(digest(payload)))
+    }
+    val inputPins = inputFiles.zip(bytes).map { case ((role, _), captured) => Json.obj("role" -> Json.fromString(role), "sha256" -> Json.fromString(digest(captured))) }
+    val receipt = Json.obj(
+      "schema" -> Json.fromString("rosen-avalanche-deployment-candidate/v1"), "chainId" -> Json.fromInt(43114),
+      "activated" -> Json.False, "minted" -> Json.False, "broadcast" -> Json.False,
+      "generatorVersion" -> Json.fromString(BuildInfo.version), "javaVersion" -> Json.fromString(System.getProperty("java.version")),
+      "scalaVersion" -> Json.fromString(scala.util.Properties.versionNumberString),
+      "inputs" -> Json.arr(inputPins: _*), "sources" -> Json.arr(sources: _*), "files" -> Json.arr(members: _*)
+    )
+    Files.write(output.resolve("manifest.json"), (receipt.spaces2 + "\n").getBytes(StandardCharsets.UTF_8))
+    println("Avalanche deployment configuration candidate prepared: contracts.json, tokens.json")
+  }
+}
diff --git a/src/main/scala/rosen/bridge/AvalanchePreparation.scala b/src/main/scala/rosen/bridge/AvalanchePreparation.scala
new file mode 100644
index 0000000..ba1c5f3
--- /dev/null
+++ b/src/main/scala/rosen/bridge/AvalanchePreparation.scala
@@ -0,0 +1,149 @@
+package rosen.bridge
+
+import helpers.{ErgoNetwork, MainTokens, Network, NetworkGeneral, Tokens}
+import info.BuildInfo
+import io.circe.Json
+import io.circe.jawn.JawnParser
+import org.ergoplatform.ErgoAddressEncoder
+import org.ergoplatform.appkit.{ColdErgoClient, NetworkType}
+
+import java.nio.charset.StandardCharsets
+import java.nio.file.{Files, Paths}
+import java.security.MessageDigest
+
+/** Compile the existing Rosen scripts offline and prepare AVAX/JOE token-map overlays. */
+object AvalanchePreparation {
+  val JoeAddress = "0x6e84a6216ea6dacc71ee8e6b0a5b7322eebc0fdd"
+  private val globalKeys = Set("RWTRepoNFT", "GuardNFT", "RSN", "MinFeeNFT", "EmissionNFT", "ERSN")
+  private val chainKeys = Set("RWTId", "CleanupNFT", "AwcNFT", "RepoConfigNFT")
+
+  /** Reject duplicate decoded field names at every object depth before assigning deployment values. */
+  def parseInput(text: String): Json = JawnParser(false).parse(text).fold(error => throw error, identity)
+
+  /** Reject missing and unexpected fields before compiling any script or writing outputs. */
+  private def objectFields(json: Json, expected: Set[String], label: String): Map[String, Json] = {
+    val fields = json.asObject.getOrElse(throw new IllegalArgumentException(s"$label must be an object"))
+    require(fields.keys.toSet == expected, s"$label requires exactly ${expected.toSeq.sorted.mkString(", ")}")
+    fields.toMap
+  }
+
+  /** Require an assigned nonzero canonical Ergo token identity. */
+  private def tokenId(json: Json, label: String): String = {
+    val value = json.asString.getOrElse(throw new IllegalArgumentException(s"$label requires an assigned token ID"))
+    require(value.matches("[0-9a-f]{64}") && value.exists(_ != '0'), s"Invalid $label token ID")
+    value
+  }
+
+  /** Require a canonical nonzero EVM custody address without network inference. */
+  private def custody(json: Json, label: String): String = {
+    val value = json.asString.getOrElse(throw new IllegalArgumentException(s"$label requires an assigned address"))
+    require(value.matches("0x[0-9a-f]{40}") && value.drop(2).exists(_ != '0'), s"Invalid $label address")
+    value
+  }
+
+  /** Read a bounded integer without accepting numeric strings, fractions or overflow. */
+  private def integer(json: Json, minimum: Int, maximum: Int, label: String): Int = {
+    val value = json.asNumber.flatMap(_.toInt).getOrElse(throw new IllegalArgumentException(s"Invalid $label integer"))
+    require(value >= minimum && value <= maximum, s"$label must be in [$minimum, $maximum]")
+    value
+  }
+
+  /** Preserve Rosen's source token types and require every bridge asset's Ergo counterpart. */
+  private def tokenSet(id: String, name: String, native: Boolean, counterpart: (String, Int)): Json = {
+    val source = Json.obj(
+      "tokenId" -> Json.fromString(id), "name" -> Json.fromString(name),
+      "decimals" -> Json.fromInt(18), "type" -> Json.fromString(if (native) "native" else "ERC-20"),
+      "residency" -> Json.fromString("native"), "extra" -> Json.obj()
+    )
+    val ergo = Json.obj(
+      "tokenId" -> Json.fromString(counterpart._1), "name" -> Json.fromString(s"rs$name"),
+      "decimals" -> Json.fromInt(counterpart._2), "type" -> Json.fromString("EIP-004"),
+      "residency" -> Json.fromString("wrapped"), "extra" -> Json.obj()
+    )
+    Json.obj("avalanche" -> source, "ergo" -> ergo)
+  }
+
+  /** Bind supplied identities to the upstream contract generator using a network-free context. */
+  def prepare(input: Json): (Json, Json) = {
+    val root = objectFields(input, Set("schema", "chainId", "cleanupConfirm", "globalTokens", "chainTokens", "custody", "counterparts"), "input")
+    require(root("schema").asString.contains("rosen-avalanche-contract-preparation/v1"), "Unknown preparation schema")
+    require(integer(root("chainId"), 43114, 43114, "chainId") == 43114, "Preparation targets mainnet")
+    val cleanup = integer(root("cleanupConfirm"), 1, Int.MaxValue, "cleanupConfirm")
+    val globals = objectFields(root("globalTokens"), globalKeys, "globalTokens").map { case (key, value) => key -> tokenId(value, key) }
+    val chain = objectFields(root("chainTokens"), chainKeys, "chainTokens").map { case (key, value) => key -> tokenId(value, key) }
+    val addresses = objectFields(root("custody"), Set("lock", "cold"), "custody")
+    val lock = custody(addresses("lock"), "lock")
+    val cold = custody(addresses("cold"), "cold")
+    require(lock != cold, "Lock and cold custody must be distinct")
+    val counterparts = objectFields(root("counterparts"), Set("avax", "joe"), "counterparts").map { case (asset, value) =>
+      val fields = objectFields(value, Set("tokenId", "decimals"), s"counterparts.$asset")
+      asset -> (tokenId(fields("tokenId"), s"counterparts.$asset"), integer(fields("decimals"), 0, 18, s"counterparts.$asset.decimals"))
+    }
+    val ids = globals.values.toSeq ++ chain.values.toSeq ++ counterparts.values.map(_._1)
+    require(ids.distinct.size == ids.size, "Token identities must not collide")
+    val sources = scriptPins()
+
+    // ColdErgoClient has no node transport; only the unchanged Rosen scripts are compiled.
+    val client = new ColdErgoClient(NetworkType.MAINNET, 1000000, 2.toByte)
+    val network = ErgoNetwork(client, new ErgoAddressEncoder(NetworkType.MAINNET.networkPrefix))
+    val main = MainTokens(globals("RWTRepoNFT"), globals("GuardNFT"), globals("RSN"), globals("MinFeeNFT"), globals("EmissionNFT"), globals("ERSN"))
+    val tokens = Tokens(chain("CleanupNFT"), chain("RWTId"), chain("AwcNFT"), chain("RepoConfigNFT"))
+    val config = Network(tokens, lock, cold, cleanup)
+    val contracts = new Contracts(NetworkGeneral(network, main), config)
+    val contractOverlay = Json.obj(
+      "version" -> Json.fromString(BuildInfo.version), "tokens" -> main.toJson(),
+      "avalanche" -> contracts.buildContractsJson("avalanche")
+    )
+    // The generic Lock also compiles for the Ergo counterparty; Avalanche uses TSS custody.
+    require(contracts.Lock._2.nonEmpty, "Ergo lock compilation failed")
+    require(scriptPins() == sources, "Contract scripts changed during compilation")
+    val tokenOverlay = Json.obj(
+      "version" -> Json.fromString(BuildInfo.version),
+      "tokens" -> Json.arr(tokenSet("avax", "AVAX", true, counterparts("avax")), tokenSet(JoeAddress, "JOE", false, counterparts("joe")))
+    )
+    (contractOverlay, tokenOverlay)
+  }
+
+  /** Hash the exact input, compiled-script sources and generated bytes for a deployment handoff. */
+  private def digest(bytes: Array[Byte]): String = MessageDigest.getInstance("SHA-256").digest(bytes).map(b => f"${b & 0xff}%02x").mkString
+
+  /** Capture the exact upstream script sources without persisting host paths. */
+  private def scriptPins(): Seq[Json] = {
+    val stream = Files.list(Paths.get("src/main/scala/rosen/bridge/scripts"))
+    try {
+      import scala.collection.JavaConverters._
+      stream.iterator().asScala.filter(_.toString.endsWith(".es")).toSeq.sortBy(_.getFileName.toString).map { path =>
+        Json.obj("path" -> Json.fromString(path.toString.replace('\\', '/')), "sha256" -> Json.fromString(digest(Files.readAllBytes(path))))
+      }
+    } finally stream.close()
+  }
+
+  /** Write a fresh preparation directory; this entry point has no minting or broadcast operation. */
+  def main(args: Array[String]): Unit = {
+    require(args.length == 4 && args(0) == "--input" && args(2) == "--output", "Usage: --input <assigned-values.json> --output <new-directory>")
+    val inputBytes = Files.readAllBytes(Paths.get(args(1)))
+    val input = parseInput(new String(inputBytes, StandardCharsets.UTF_8))
+    val sourcePins = scriptPins()
+    val (contracts, tokens) = prepare(input)
+    require(scriptPins() == sourcePins, "Contract scripts changed before output preparation")
+    val output = Paths.get(args(3))
+    require(!Files.exists(output), "Output directory must be new")
+    val parent = output.toAbsolutePath.getParent
+    require(Files.isDirectory(parent), "Output parent must exist")
+    val payloads = Seq("contracts-overlay.json" -> contracts, "tokens-overlay.json" -> tokens)
+    Files.createDirectory(output)
+    val members = payloads.map { case (name, value) =>
+      val bytes = (value.spaces2 + "\n").getBytes(StandardCharsets.UTF_8)
+      Files.write(output.resolve(name), bytes)
+      Json.obj("path" -> Json.fromString(name), "bytes" -> Json.fromInt(bytes.length), "sha256" -> Json.fromString(digest(bytes)))
+    }
+    val manifest = Json.obj(
+      "schema" -> Json.fromString("rosen-avalanche-contract-preparation-receipt/v1"),
+      "chainId" -> Json.fromInt(43114), "mode" -> Json.fromString("offline-preparation"),
+      "minted" -> Json.False, "broadcast" -> Json.False, "inputSha256" -> Json.fromString(digest(inputBytes)),
+      "scripts" -> Json.arr(sourcePins: _*), "files" -> Json.arr(members: _*)
+    )
+    Files.write(output.resolve("manifest.json"), (manifest.spaces2 + "\n").getBytes(StandardCharsets.UTF_8))
+    println(s"Avalanche contract and token overlays prepared: ${members.size} files")
+  }
+}
