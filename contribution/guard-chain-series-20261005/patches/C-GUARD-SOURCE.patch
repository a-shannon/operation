+} from '@rosen-chains/abstract-chain';
+import { AvalancheChain } from '@rosen-chains/avalanche';
+import {
+  AVALANCHE_TX_EXTRACTOR,
+  AvalancheRpcNetwork,
+} from '@rosen-chains/avalanche-rpc';
+
