+  vi.spyOn(MinimumFeeHandler, 'getEventFeeConfig').mockReturnValue({
+    bridgeFee: 0n,
+    networkFee: 0n,
+    rsnRatio: 0n,
+    feeRatio: 0n,
+    rsnRatioDivisor: 1000000000000n,
+    feeRatioDivisor: 10000n,
+  });
+  await DatabaseActionMock.insertOnlyEventDataRecord(event);
+  return {
+    event,
+    network,
+    rpc,
+    receipt,
+    chain,
+    confirmation,
+    decoded,
+    lockConditions,
