+import '@rosen-bridge/extended-typeorm/bootstrap';
+
+import { blake2b } from 'blakejs';
+
+import {
+  BlockEntity,
+  ExtractorStatusEntity,
+  migrations,
+} from '@rosen-bridge/abstract-scanner';
+import {
+  AvalancheRpcNetwork,
