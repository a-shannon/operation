+import { Signature, Transaction } from 'ethers';
+
+import {
+  AvalancheRpcNetwork as ScannerNetwork,
+  AvalancheRpcScanner,
+  AvalancheSafetyState,
+} from '@rosen-bridge/evm-scanner';
