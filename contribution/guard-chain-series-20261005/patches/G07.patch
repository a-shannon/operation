+      const request = new FetchRequest(rpcUrl);
+      if (timeoutMs !== undefined) request.timeout = timeoutMs;
+      if (getUrlFunc !== undefined) request.getUrlFunc = getUrlFunc;
+      this.provider = new JsonRpcProvider(request);
