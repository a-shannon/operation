+import type { QueryRunner } from '@rosen-bridge/extended-typeorm';
+
+/** Captures migration SQL with a controlled unsafe-row result. */
+export const mockQueryRunner = (unsafe = false) => {
+  const query = vi.fn().mockResolvedValue([]);
